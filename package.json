{
  "name": "tokoku-pos",
  "version": "1.0.0",
  "description": "Aplikasi Pencatatan Toko & POS Android-Ready dengan Fitur Kasir, Stok, Laporan Laba/Rugi, Struk Thermal & Notifikasi WhatsApp/Telegram",
  "main": "index.html",
  "scripts": {
    "start": "npx serve . -p 3000",
    "dev": "npx serve . -p 3000",
    "cap:init": "npx cap init TokoKu com.tokoku.pos --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android"
  },
  "keywords": [
    "pos",
    "kasir",
    "pencatatan-toko",
    "android-apk",
    "pwa",
    "inventory",
    "laporan-keuangan"
  ],
  "author": "TokoKu POS",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  }
}
